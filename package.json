{
	"name": "vite-mpa",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=25.1.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "npm run build:sw && vite build",
		"preview": "vite preview",
		"eslint": "npx eslint",
		"lint": "npx oxlint && npx eslint",
		"oxlint": "npx oxlint",
		"generate-cf-types": "npx wrangler types ./cloudflare/env.d.ts --config ./wrangler.jsonc",
		"test": "vitest --config ./vitest.config.ts",
		"integration-test": "vitest run --coverage --config ./vitest.config.browser.ts",
		"test-coverage": "vitest --coverage --config ./vitest.config.ts",
		"build:sw": "tsc --project sw/tsconfig.json --outDir compiled-sw",
		"clean-install": "node -e \"const fs = require('fs'); fs.rmSync('node_modules', { recursive: true, force: true }); fs.rmSync('package-lock.json', { force: true });\" && npm install",
		"update-packages": "ncu -u && npm install"
	},
	"browserslist": {
		"production": [
			"> 1%",
			"not dead"
		],
		"modern": [
			"last 1 chrome version",
			"last 1 firefox version"
		]
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.13.19",
		"@cloudflare/vitest-pool-workers": "^0.10.4",
		"@cloudflare/workers-types": "^4.20251014.0",
		"@eslint/css": "^0.14.1",
		"@eslint/js": "^9.39.1",
		"@html-eslint/eslint-plugin": "^0.47.1",
		"@types/glob": "^9.0.0",
		"@types/wait-on": "^5.3.4",
		"@vitest/browser": "^3.2.4",
		"@vitest/coverage-v8": "^3.2.4",
		"browserslist-config-baseline": "^0.5.0",
		"cheerio": "1.1.2",
		"eslint": "^9.39.1",
		"eslint-plugin-compat": "^6.0.2",
		"eslint-plugin-oxlint": "^1.25.0",
		"get-port": "^7.1.0",
		"glob": "^11.0.3",
		"globals": "^16.5.0",
		"jiti": "^2.6.1",
		"npm-check-updates": "^19.1.2",
		"oxlint": "^1.25.0",
		"playwright": "^1.56.1",
		"rollup": "^4.52.5",
		"tree-kill": "^1.2.2",
		"tsconfigurator": "^2.0.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.3",
		"vite": "npm:rolldown-vite@latest",
		"vitest": "^3.2.4",
		"wait-on": "^9.0.1",
		"wrangler": "^4.45.4"
	}
}
